@page
@model Store.Web.Pages.ErrorModel
@{ ViewData["Title"] = "Не вдалося виконати дію"; }
<div class="error-panel surface">
 <span class="eyebrow">Потрібна увага</span>
 <h1>Не вдалося виконати дію</h1>
 @if (Model.ErrorStatus == 400) {
  <p>Форма застаріла або запит некоректний. Якщо ви переключили менеджера, оновіть сторінку з формою та повторіть дію.</p>
 } else if (Model.ErrorStatus == 404) {
  <p>Цю сторінку або запис не знайдено.</p>
 } else {
  <p>Перевірте, чи запущена база даних, і спробуйте ще раз. Якщо помилка повторюється, скористайтеся інструкцією запуску застосунку.</p>
 }
 <a class="btn btn-primary" asp-page="/Index">Повернутися до огляду</a>
</div>

